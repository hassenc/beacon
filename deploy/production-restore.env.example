# Used only from a maintenance host/destination. The restore script creates a
# new beacon_restore_* database and never accepts a caller-supplied live name.
BEACON_BIN=/opt/beacon/bin/beacon
BEACON_BACKUP_KEY_FILE=/srv/beacon/secrets/backup.key
BEACON_KEY_FILE=/srv/beacon/secrets/encryption_key
BEACON_PG_RESTORE_MAINTENANCE_URL=postgres://migration_owner:REDACTED@restore-db/postgres?sslmode=verify-full
BEACON_PG_RESTORE_URL_TEMPLATE=postgres://beacon_runtime:REDACTED@restore-db/%s?sslmode=verify-full
BEACON_PG_RESTORE_ADMIN_URL_TEMPLATE=postgres://migration_owner:REDACTED@restore-db/%s?sslmode=verify-full
BEACON_RUNTIME_GRANTS_FILE=/opt/beacon/deploy/runtime-grants.sql
BEACON_RESTORE_KEEP=0
