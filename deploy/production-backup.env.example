# Copy to a root-owned private file and fill with deployment-specific values.
# Never commit the filled file. BEACON_BACKUP_DEST_DIR should be an already
# mounted off-host or independently retained destination.
BEACON_BIN=/opt/beacon/bin/beacon
BEACON_BACKUP_KEY_FILE=/srv/beacon/secrets/backup.key
BEACON_PG_SOURCE_DATABASE_URL=postgres://backup_reader:REDACTED@db.example/beacon?sslmode=verify-full
BEACON_BACKUP_OUTPUT_DIR=/var/lib/beacon/backups
BEACON_BACKUP_DEST_DIR=/mnt/offhost/beacon
BEACON_BACKUP_MOUNTPOINT=/mnt/offhost
BEACON_BACKUP_RETENTION_DAYS=35
BEACON_BACKUP_PRUNE=0
BEACON_BACKUP_REQUIRE_MOUNT=1
BEACON_SOURCE_IDENTITY=deployment/beacon
BEACON_SCHEMA_IDENTITY=schema-4
BEACON_IMAGE_ID=sha256:REVIEWED_IMAGE_DIGEST
