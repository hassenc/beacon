# The alert URL must be independent of Beacon SMTP. A private ntfy topic or
# an existing webhook receiver is suitable; do not put tokens in this file.
BEACON_MONITOR_HEALTH_URL=https://beacon.example/healthz
BEACON_MONITOR_BACKUP_DIR=/mnt/offhost/beacon
BEACON_MONITOR_DISK_PATH=/var/lib/beacon
BEACON_MONITOR_DATABASE_URL_FILE=/srv/beacon/secrets/monitor_database_url
BEACON_MONITOR_STATE_FILE=/var/lib/beacon/monitor-state.json
BEACON_ALERT_URL=https://alerts.example/hooks/beacon
BEACON_ALERT_TOKEN_FILE=/srv/beacon/secrets/alert_token
BEACON_HEALTH_FAILURES=3
BEACON_PENDING_AGE_SECONDS=900
BEACON_BACKUP_AGE_SECONDS=93600
BEACON_DISK_FREE_PERCENT=20
