# Use scripts/setup.sh to generate independent secrets. Never deploy these placeholders.
POSTGRES_PASSWORD=GENERATE_A_RANDOM_SECRET
BEACON_KEY=GENERATE_64_HEX_CHARACTERS
# Required for the supported encrypted backup path; keep this key in separate custody.
BEACON_BACKUP_KEY_FILE=/run/secrets/beacon_backup_key
BEACON_ADMIN_EMAIL=owner@example.com
BEACON_ADMIN_PASSWORD=GENERATE_A_LONG_UNIQUE_PASSWORD
BEACON_ORG="Your organization"
BEACON_URL=http://localhost:8787
BEACON_DEV=true
BEACON_SECURITY_EXPIRES=2027-03-01T00:00:00Z
# Only set when a trusted reverse proxy terminates TLS and appends X-Forwarded-For.
BEACON_TRUSTED_PROXY_CIDRS=
